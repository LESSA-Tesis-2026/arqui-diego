LESSA_APP_NAME="LESSA Translation API"
LESSA_API_PREFIX="/api/v1"
LESSA_CORS_ORIGINS='["http://localhost:3000"]'

# Preferred runtime locations. Copy or mount trained artifacts here.
LESSA_WORD_MODEL_PATH="../../models/modelo_señas_lstm.keras"
LESSA_ALPHABET_MODEL_PATH="../../models/modelo_letras.h5"

LESSA_SEQUENCE_LENGTH=60
LESSA_WINDOW_SIZE=25
LESSA_BASE_FEATURE_LENGTH=306
LESSA_USE_TEMPORAL_FEATURES=true
LESSA_TEMPORAL_DELTA_ORDER=2
LESSA_WORD_CONFIDENCE_THRESHOLD=0.65
LESSA_ALPHABET_CONFIDENCE_THRESHOLD=0.80
LESSA_HYBRID_MOTION_THRESHOLD=0.010
LESSA_SETTLE_SECONDS=3.0
LESSA_INFERENCE_INTERVAL_SECONDS=0.75
LESSA_HOLD_LAST_READING_SECONDS=2.0
LESSA_VOTING_BUFFER_SIZE=10
LESSA_MIN_VOTES=7
LESSA_ALPHABET_VOTING_BUFFER_SIZE=5
LESSA_ALPHABET_MIN_VOTES=3
LESSA_MAX_SENTENCE_WORDS=5
LESSA_PAUSE_RESET_FRAMES=15
